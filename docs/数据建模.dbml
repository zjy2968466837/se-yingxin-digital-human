// 迎新生数字人系统 · 数据模型（DBML）
// 由 docs/数据建模.md 自动生成 —— **勿手工改本文件**：改表结构先改文档，再重新生成本文件
// 生成脚本见 .codebuddy/tmp/gen_dbml.py（不入库）。
// 用法：dbdiagram.io → New diagram → 粘贴本文件 → 出关系图 → Export 生成 MySQL DDL。
//
// ⚠️ 落地三条纪律（本项目硬约束，见 docs/开发规范.md §5）：
//   1) 禁止物理外键：下方 Ref 仅用于画关系线，**导出 DDL 后必须删掉 FOREIGN KEY 子句**，
//      或先把 Ref 段整段注释掉再导出；引用存在性由应用层校验。
//   2) 表名/字段名全小写 + 下划线（本地 lower_case_table_names=1，驼峰上线会报"表不存在"）。
//   3) id 为雪花 ID（BIGINT），不要改成自增；deleted 为 BIGINT（0=未删除，删除时写入行 id）。
//
// 范围：33 张表中，需求分析文档 §8.4.1 建议裁剪 8 张、合并 1 张（一期约 24 张），
// 建表前先看该节结论，不要照单全建。

Table auth_user {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  student_no           VARCHAR(32)      [note: '学号，与 openid 至少一个非空']
  openid               VARCHAR(64)      [note: '微信 openid，唯一']
  unionid              VARCHAR(64)      [note: '微信 unionid，有则唯一']
  real_name            VARCHAR(32)      [note: '姓名（敏感，脱敏展示）']
  phone                VARCHAR(20)      [note: '手机号（加密存储）']
  id_card              VARCHAR(255)     [note: '身份证号（密文存储，仅实名核验与审计使用，禁止出接口与进日志）']
  password_hash        VARCHAR(100)     [note: '仅管理员/特殊账号用；BCrypt']
  status               TINYINT          [not null, note: '1 正常 / 2 禁用 / 3 未激活']
  last_login_time      DATETIME(3)      [note: '最近登录时间']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (openid) [unique, name: 'uk_openid']
    (student_no) [unique, name: 'uk_student_no']
    (phone) [name: 'idx_phone']
  }

  Note: '用户账号'
}

Table auth_identity {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '唯一']
  edu_level            TINYINT          [not null, note: '1 本科 / 2 研究生 / 3 其他']
  college              VARCHAR(64)      [note: '学院']
  major                VARCHAR(64)      [note: '专业']
  class_name           VARCHAR(64)      [note: '班级']
  dorm_building        VARCHAR(32)      [note: '宿舍楼栋']
  dorm_room            VARCHAR(32)      [note: '宿舍房间']
  batch_id             BIGINT           [not null, note: '报到批次，引用 admin_config 中的批次定义']
  admission_type       TINYINT          [note: '1 统招 / 2 专项 / 3 其他（影响迎新清单）']
  source               TINYINT          [not null, note: '1 学校身份源 / 2 模拟数据（C-6、A-2）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (user_id) [unique, name: 'uk_user_id']
    (college, batch_id) [name: 'idx_college_batch']
  }

  Note: '身份档案'
}

Table auth_push_record {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '接收人']
  channel              TINYINT          [not null, note: '1 站内信 / 2 公众号模板消息']
  title                VARCHAR(64)      [not null, note: '推送内容']
  content              VARCHAR(512)     [not null, note: '推送内容']
  biz_type             TINYINT          [note: '关联业务（如报到步骤）']
  biz_id               BIGINT           [note: '关联业务（如报到步骤）']
  status               TINYINT          [not null, note: '1 待发 / 2 成功 / 3 失败']
  retry_count          INT              [not null, note: '默认 0，失败重试计数']
  fail_reason          VARCHAR(255)     [note: '失败原因']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (user_id, status) [name: 'idx_user_status']
    (create_time) [name: 'idx_create_time']
  }

  Note: '待办推送记录'
}

Table checkin_step_template {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  step_code            VARCHAR(32)      [not null, note: '步骤编码，唯一（如 PRE_REG、PAY）']
  step_name            VARCHAR(64)      [not null, note: '步骤名称']
  seq                  INT              [not null, note: '顺序号，从 1 递增']
  apply_scope          JSON             [note: '适用人群（学历/批次/学院），空=全部']
  location             VARCHAR(128)     [note: '办理地点']
  office_hours         VARCHAR(64)      [note: '办公时间']
  contact              VARCHAR(64)      [note: '联系人电话']
  enabled              TINYINT(1)       [not null, note: '启停开关']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (step_code) [unique, name: 'uk_step_code']
  }

  Note: '报到步骤模板'
}

Table checkin_material_item {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  step_code            VARCHAR(32)      [not null, note: '归属步骤']
  name                 VARCHAR(64)      [not null, note: '材料名称（通知书/档案/党团关系/照片/户口）']
  required             TINYINT(1)       [not null, note: '是否必需']
  remark               VARCHAR(255)     [note: '补交说明']
  seq                  INT              [not null, note: '展示顺序']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (step_code) [name: 'idx_step']
  }

  Note: '材料清单项'
}

Table checkin_progress {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '学生']
  step_code            VARCHAR(32)      [not null, note: '步骤']
  status               TINYINT          [not null, note: '1 待办 / 2 已完成 / 3 不适用']
  checkin_time         DATETIME(3)      [note: '打卡时间']
  checkin_channel      TINYINT          [note: '1 自助确认 / 2 现场扫码']
  operator_id          BIGINT           [note: '代打卡的经办人']
  remark               VARCHAR(255)     [note: '备注']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (user_id, step_code, deleted) [unique, name: 'uk_user_step']
    (user_id, status) [name: 'idx_user_status']
    (step_code, status) [name: 'idx_step_status']
  }

  Note: '报到进度记录'
}

Table checkin_certificate {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '学生']
  batch_id             BIGINT           [not null, note: '报到批次（签发时写入，DI-5「同批次一张有效凭证」的判定依据）']
  cert_no              VARCHAR(32)      [not null, note: '凭证编号，唯一']
  qr_token             VARCHAR(64)      [not null, note: '二维码令牌（签名值，不可反推个人信息）']
  issued_time          DATETIME(3)      [not null, note: '签发时间']
  expire_time          DATETIME(3)      [not null, note: '过期时间']
  verify_status        TINYINT          [not null, note: '1 未核销 / 2 已核销 / 3 已作废']
  verify_by            BIGINT           [note: '核销人与时间']
  verify_time          DATETIME(3)      [note: '核销人与时间']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (cert_no) [unique, name: 'uk_cert_no']
    (qr_token) [unique, name: 'uk_qr_token']
    (user_id, batch_id) [name: 'idx_user_batch']
  }

  Note: '报到凭证'
}

Table qa_question {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  question             VARCHAR(255)     [not null, note: '标准问法']
  answer               MEDIUMTEXT       [not null, note: '答案正文']
  answer_type          TINYINT          [not null, note: '1 纯文本 / 2 富媒体']
  category             VARCHAR(32)      [not null, note: '知识域（对应意图分类）']
  tags                 VARCHAR(255)     [note: '标签，逗号分隔或 JSON']
  synonyms             TEXT             [note: '同义词/口语化表达（F3.4）']
  media                JSON             [note: '富媒体块定义（图/流程图/视频/点位，F3.7）']
  status               TINYINT          [not null, note: '1 已发布 / 2 草稿 / 3 停用']
  hit_count            BIGINT           [not null, note: '命中次数（默认 0）']
  version              INT              [not null, note: '内容版本号，用于缓存失效']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (category, status) [name: 'idx_category_status']
    // FULLTEXT WITH PARSER ngram（中文分词；DBML 无此 setting，导出 DDL 后手工补）
    (question, synonyms) [name: 'idx_question']
  }

  Note: '问答条目'
}

Table qa_session {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '学生']
  channel              TINYINT          [not null, note: '1 学生端网页 / 2 管理后台']
  start_time           DATETIME(3)      [not null, note: '会话开始']
  end_time             DATETIME(3)      [note: '会话结束']
  message_count        INT              [not null, note: '消息数，默认 0']
  satisfied            TINYINT          [note: '满意度（可空）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (user_id, start_time) [name: 'idx_user_time']
  }

  Note: '会话'
}

Table qa_message {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  session_id           BIGINT           [not null, note: '所属会话']
  role                 TINYINT          [not null, note: '1 用户 / 2 数字人']
  content              TEXT             [not null, note: '消息内容，加密存储']
  content_type         TINYINT          [not null, note: '1 文本 / 2 富媒体']
  question_id          BIGINT           [note: '命中的问答条目（未命中为空）']
  confidence           DECIMAL(5,2)     [note: '置信度 0–100']
  llm_used             TINYINT(1)       [not null, note: '是否走了 LLM 兜底，默认 0']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (session_id, create_time) [name: 'idx_session']
  }

  Note: '消息'
}

Table qa_unanswered {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  question             VARCHAR(255)     [not null, note: '原始问题']
  session_id           BIGINT           [note: '来源']
  user_id              BIGINT           [note: '来源']
  confidence           DECIMAL(5,2)     [note: '最高置信度']
  status               TINYINT          [not null, note: '1 待处理 / 2 已转人工 / 3 已补录问答库 / 4 已忽略']
  handler_id           BIGINT           [note: '处理人（志愿者/辅导员，ACT-3）']
  handle_note          VARCHAR(255)     [note: '处理说明']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (status, create_time) [name: 'idx_status_time']
    (user_id, create_time) [name: 'idx_user']
  }

  Note: '未解答记录'
}

Table qa_ask_log {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [note: '匿名访问时为空']
  question_hash        CHAR(64)         [not null, note: '问题指纹（SHA-256 十六进制 64 位，定长），不存原文避免重复存敏感信息']
  hit_type             TINYINT          [not null, note: '1 缓存命中 / 2 问答库命中 / 3 LLM 兜底 / 4 未命中']
  cost_ms              INT              [not null, note: '响应耗时（NFR-1.1 度量）']
  session_id           BIGINT           [note: '关联会话']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (create_time) [name: 'idx_create_time']
  }

  Note: '提问日志'
}

Table aid_policy {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  name                 VARCHAR(128)     [not null, note: '政策名称']
  category             TINYINT          [not null, note: '1 国家助学金 / 2 助学贷款 / 3 勤工助学 / 4 困难补助 / 5 缓交学费 / 6 其他']
  content              MEDIUMTEXT       [not null, note: '政策正文']
  match_rule           JSON             [note: '适用条件（学历/批次/困难等级），F5.2 匹配用']
  material_list        TEXT             [note: '所需材料明细（F5.3）']
  contact              VARCHAR(64)      [note: '咨询电话与办理地点（F5.4）']
  location             VARCHAR(128)     [note: '咨询电话与办理地点（F5.4）']
  online_entry         VARCHAR(255)     [note: '在线办理入口']
  need_apply           TINYINT(1)       [not null, note: '是否需要线上申请（区分"仅查询"与"可申请"）']
  status               TINYINT          [not null, note: '1 启用 / 2 停用']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (category, status) [name: 'idx_category_status']
  }

  Note: '资助政策'
}

Table aid_application {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  user_id              BIGINT           [not null, note: '申请学生']
  policy_id            BIGINT           [not null, note: '申请的政策']
  batch_id             BIGINT           [not null, note: '报到批次']
  apply_type           TINYINT          [not null, note: '1 绿色通道 / 2 缓交学费 / 3 其他']
  reason               VARCHAR(512)     [note: '申请理由（敏感，加密）']
  status               TINYINT          [not null, note: '1 草稿 / 2 待审核 / 3 已通过 / 4 已驳回 / 5 已撤回']
  submit_time          DATETIME(3)      [note: '提交与审核时间']
  audit_time           DATETIME(3)      [note: '提交与审核时间']
  auditor_id           BIGINT           [note: '审核人（ACT-4）']
  reject_reason        VARCHAR(255)     [note: '驳回必填（F5.8 验收准则）']
  materials            JSON             [note: '材料明细：[{name,url,hash,status}]，一份申请 1–3 项（材料名、文件地址、指纹、该项状态）']
  version              INT              [not null, note: '乐观锁，防并发审核覆盖（默认 0）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (user_id, policy_id, batch_id, deleted) [unique, name: 'uk_user_policy_batch']
    (status, create_time) [name: 'idx_status_time']
    (policy_id, status) [name: 'idx_policy_status']
  }

  Note: '资助申请'
}

Table life_repair_order {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  order_no             VARCHAR(32)      [not null, note: '单号，唯一']
  user_id              BIGINT           [not null, note: '报修人']
  dorm_location        VARCHAR(64)      [not null, note: '楼栋+房间']
  category             TINYINT          [not null, note: '1 水电 / 2 家具 / 3 网络 / 4 门窗 / 5 其他']
  description          VARCHAR(512)     [note: '故障描述']
  images               JSON             [note: '照片地址数组（最多 3 张）']
  status               TINYINT          [not null, note: '1 待受理 / 2 处理中 / 3 已完成 / 4 已取消']
  handler_id           BIGINT           [note: '处理人']
  finish_time          DATETIME(3)      [note: '完成时间']
  external_order_no    VARCHAR(64)      [note: '后勤系统单号（对接失败时为空，IR-2.9）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (order_no) [unique, name: 'uk_order_no']
    (user_id, create_time) [name: 'idx_user_time']
    (status, create_time) [name: 'idx_status_time']
  }

  Note: '报修单'
}

Table life_service_info {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  category             TINYINT          [not null, note: '1 洗衣机/热水 / 2 门禁 / 3 食堂 / 4 校园网 / 5 营业厅快递 / 6 就医医保 / 7 心理中心 / 8 FAQ']
  title                VARCHAR(128)     [not null, note: '标题']
  content              MEDIUMTEXT       [not null, note: '说明内容（支持图文）']
  location             VARCHAR(128)     [note: '地点']
  poi_code             VARCHAR(32)      [note: '关联导航点位（引用 poi.json 的 poi_code，可跳转 F6.7）']
  phone                VARCHAR(32)      [note: '一键拨号号码（F6.9）']
  open_hours           VARCHAR(64)      [note: '营业/开放时间']
  extra                JSON             [note: '分类特有信息（如套餐、菜单）']
  status               TINYINT          [not null, note: '1 启用 / 2 停用']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (category, status) [name: 'idx_category_status']
  }

  Note: '生活服务信息'
}

Table content_article {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  module               TINYINT          [not null, note: '1 安全教育 / 2 入学教育 / 3 校规校纪 / 4 军训安排 / 5 招新信息']
  title                VARCHAR(128)     [not null, note: '标题']
  summary              VARCHAR(255)     [note: '摘要（列表页）']
  content              MEDIUMTEXT       [not null, note: '正文']
  cover_url            VARCHAR(255)     [note: '封面图']
  source               VARCHAR(128)     [note: '来源（NFR 可注明出处）']
  push_stage           TINYINT          [note: '推送阶段（报到前/中/后，F7.2）']
  start_time           DATETIME(3)      [note: '有效期（招新、军训用）']
  end_time             DATETIME(3)      [note: '有效期（招新、军训用）']
  poi_code             VARCHAR(32)      [note: '关联地点（引用 poi.json 的 poi_code，招新/军训地点，可跳导航）']
  status               TINYINT          [not null, note: '1 草稿 / 2 已发布 / 3 已下线']
  publish_time         DATETIME(3)      [note: '发布时间（F9.5 定时发布）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (module, status) [name: 'idx_module_status']
    (publish_time) [name: 'idx_publish_time']
  }

  Note: '内容条目'
}

Table admin_user {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  username             VARCHAR(32)      [not null, note: '登录名，唯一']
  password_hash        VARCHAR(100)     [not null, note: 'BCrypt 散列，禁止明文']
  real_name            VARCHAR(32)      [not null, note: '姓名']
  dept                 TINYINT          [not null, note: '1 学工 / 2 后勤 / 3 保卫 / 4 学院 / 5 信息中心（ACT-4）']
  status               TINYINT          [not null, note: '1 正常 / 2 禁用']
  last_login_time      DATETIME(3)      [note: '最近登录时间']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (username) [unique, name: 'uk_username']
  }

  Note: '管理员'
}

Table admin_role {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  role_code            VARCHAR(32)      [not null, note: '角色编码，唯一，权限判定以此为准']
  role_name            VARCHAR(64)      [not null, note: '角色名称']
  remark               VARCHAR(255)     [note: '备注']
  status               TINYINT          [not null, note: '1 启用 / 2 停用']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (role_code) [unique, name: 'uk_role_code']
  }

  Note: '角色'
}

Table admin_user_role {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  admin_user_id        BIGINT           [not null, note: '管理员']
  role_id              BIGINT           [not null, note: '角色']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (admin_user_id, role_id) [unique, name: 'uk_user_role']
  }

  Note: '管理员角色关联'
}

Table admin_announcement {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  title                VARCHAR(128)     [not null, note: '标题与正文']
  content              MEDIUMTEXT       [not null, note: '标题与正文']
  audience             JSON             [note: '可见人群（学院/批次），空=全部']
  publish_time         DATETIME(3)      [note: '定时发布与撤回（F9.5）']
  revoke_time          DATETIME(3)      [note: '定时发布与撤回（F9.5）']
  status               TINYINT          [not null, note: '1 草稿 / 2 已发布 / 3 已撤回']
  publisher_id         BIGINT           [not null, note: '发布人']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (status, publish_time) [name: 'idx_status_publish']
  }

  Note: '公告'
}

Table admin_config {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  config_key           VARCHAR(64)      [not null, note: '配置键，唯一（如 checkin.batch.no，取值字典见 [需求分析文档](需求分析文档.md) §7.1.4）']
  config_value         TEXT             [not null, note: '配置值（JSON/字符串）']
  config_group         VARCHAR(32)      [not null, note: '分组（批次 / 时间窗口 / 开关）']
  value_type           TINYINT          [not null, note: '1 字符串 / 2 数字 / 3 布尔 / 4 JSON']
  remark               VARCHAR(255)     [note: '说明']
  editable             TINYINT(1)       [not null, note: '是否允许后台修改']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (config_key) [unique, name: 'uk_config_key']
  }

  Note: '系统配置'
}

Table admin_operation_log {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  admin_user_id        BIGINT           [not null, note: '操作人']
  module               VARCHAR(32)      [not null, note: '模块与动作（如 qa_question / publish）']
  action               VARCHAR(32)      [not null, note: '模块与动作（如 qa_question / publish）']
  target_type          VARCHAR(32)      [note: '操作对象']
  target_id            BIGINT           [note: '操作对象']
  detail               TEXT             [note: '变更摘要（脱敏后）']
  before_value         JSON             [note: '变更前后值快照（仅记录被改动字段，脱敏后）；用于审计回溯（NFR-4.6）']
  after_value          JSON             [note: '变更前后值快照（仅记录被改动字段，脱敏后）；用于审计回溯（NFR-4.6）']
  client_ip            VARCHAR(45)      [note: '来源 IP']
  result               TINYINT          [not null, note: '1 成功 / 2 失败']
  trace_id             VARCHAR(64)      [note: '链路 id，便于与日志系统关联']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (admin_user_id, create_time) [name: 'idx_admin_time']
    (module, create_time) [name: 'idx_module_time']
    (trace_id) [name: 'idx_trace']
  }

  Note: '操作日志'
}

Table admin_behavior_event {
  id                   BIGINT           [pk, note: '雪花 ID，主键']
  event_type           TINYINT          [not null, note: '1 问答 / 2 导航 / 3 报到打卡 / 4 内容阅读 / 5 页面访问']
  user_id              BIGINT           [note: '匿名可空']
  service              VARCHAR(32)      [note: '来源服务与业务对象']
  ref_id               BIGINT           [note: '来源服务与业务对象']
  channel              TINYINT          [not null, note: '1 学生端网页 / 2 管理后台']
  ext                  JSON             [note: '附加维度（学院、批次、耗时等）']
  event_time           DATETIME(3)      [not null, note: '事件发生时间（不用 create_time 代替，允许延迟上报）']
  create_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  update_time          DATETIME(3)      [not null, note: '持久层自动填充，业务代码不得手写']
  create_by            BIGINT           [note: '操作人 id，系统写入为 0']
  update_by            BIGINT           [note: '操作人 id，系统写入为 0']
  deleted              BIGINT           [not null, default: 0, note: '逻辑删除：0=未删除；删除时写入本行 id（文档 §5.1）']

  indexes {
    (event_type, event_time) [name: 'idx_type_time']
    (user_id, event_time) [name: 'idx_user_time']
  }

  Note: '埋点事件'
}

// ===== 逻辑引用（Ref 仅供画线；导出 DDL 前请删除或注释掉本段） =====
Ref: auth_identity.user_id > auth_user.id
Ref: checkin_progress.step_code > checkin_step_template.step_code
Ref: checkin_certificate.user_id > auth_user.id
Ref: qa_message.session_id > qa_session.id
Ref: aid_application.policy_id > aid_policy.id
Ref: admin_user_role.admin_user_id > admin_user.id
Ref: admin_user_role.role_id > admin_role.id
