@startuml 03-系统用例图
!pragma layout smetana
' =====================================================================
' 大学生迎新导引服务数字人系统 —— 系统用例图
' 数据来源：docs/功能清单.md v1.0（角色见 §0.3，模块见 §1）
' 渲染方式（PNG + SVG 图片）：
'   java -jar plantuml.jar -charset UTF-8 -tpng -tsvg 03-系统用例图.puml
'   或 VS Code「PlantUML」扩展 Alt+D 预览后导出图片
' =====================================================================
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam ArrowColor #526D82
skinparam ArrowFontSize 11
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #526D82
  FontSize 13
}
skinparam usecase {
  BackgroundColor #EEF4FB
  BorderColor #526D82
  FontSize 12
}
skinparam rectangle {
  BackgroundColor #FAFCFE
  BorderColor #94A3B8
  FontStyle bold
}
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #D9B34A
skinparam NoteFontSize 11

title 大学生迎新导引服务数字人系统 · 系统用例图

actor "新生\n（第一用户）" as A_Student
actor "家长 / 访客\n（只读咨询）" as A_Guest
actor "志愿者 / 辅导员\n（现场答疑）" as A_Volunteer
actor "学校管理员\n（学工/后勤/保卫/学院）" as A_Admin
actor "系统运维" as A_Ops

rectangle "迎新导引服务数字人系统" {

  usecase "身份核验与登录\nF1.1–F1.3" as UC_Login
  usecase "个性化信息与\n专属报到清单\nF1.4–F1.6" as UC_Profile
  usecase "报到步骤引导\n与进度打卡\nF2.1–F2.5" as UC_Checkin
  usecase "材料与缴费\n异常处理\nF2.6–F2.9" as UC_Material
  usecase "智能问答咨询\n（文字 / 语音）\nF3.1–F3.9" as UC_QA
  usecase "校园 AR / 3D 导航\nF4.1–F4.10" as UC_Nav
  usecase "资助政策查询与\n绿色通道申请\nF5.1–F5.7" as UC_Aid
  usecase "生活服务办理\n报修/缴费/就医\nF6.1–F6.10" as UC_Life
  usecase "安全学习与\n紧急电话拨号\nF7.1–F7.6" as UC_Safety
  usecase "社团与入学适应\nF8.1–F8.5" as UC_Club
  usecase "未解答问题\n转人工处理\nF3.11" as UC_Transfer
  usecase "内容与话术管理\nF9.3–F9.5、F9.8" as UC_Content
  usecase "数据统计看板\nF9.6–F9.7" as UC_Stats
  usecase "分权限管理\n（RBAC）\nF9.2" as UC_Rbac
  usecase "系统配置与运维\nF9.10、F11.6–F11.7" as UC_Ops
}

A_Student --> UC_Login
A_Student --> UC_Profile
A_Student --> UC_Checkin
A_Student --> UC_Material
A_Student --> UC_QA
A_Student --> UC_Nav
A_Student --> UC_Aid
A_Student --> UC_Life
A_Student --> UC_Safety
A_Student --> UC_Club

A_Guest --> UC_QA
A_Guest --> UC_Nav
A_Guest --> UC_Safety

A_Volunteer --> UC_Transfer

A_Admin --> UC_Content
A_Admin --> UC_Stats
A_Admin --> UC_Rbac

A_Ops --> UC_Ops

UC_Profile ..> UC_Login : <<include>>
UC_Checkin ..> UC_Login : <<include>>
UC_Aid ..> UC_Login : <<include>>
UC_Life ..> UC_Login : <<include>>
UC_Content ..> UC_Rbac : <<include>>
UC_Stats ..> UC_Rbac : <<include>>
UC_QA ..> UC_Nav : <<extend>>

legend bottom
  **说明**
  · 用例编号 F x.y 与 docs/功能清单.md 一一对应
  · M10 数字人形象与多端适配为跨服务能力，不单列为用例，体现在各端交互中
  · 当前为 M3 骨架阶段，业务用例均待开发
end legend

@enduml
