@startuml 07-功能架构子图-智能问答与校园导航
!pragma layout smetana
' =====================================================================
' 功能架构子图 2 —— 智能问答与校园导航（M3 qa-service + M4 navigation-service）
' 数据来源：docs/功能清单.md v1.0 §2
' 渲染方式（PNG + SVG 图片）：
'   java -jar plantuml.jar -charset UTF-8 -tpng -tsvg 07-功能架构子图-智能问答与校园导航.puml
' =====================================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam ArrowColor #526D82
skinparam ArrowFontSize 10
skinparam rectangle {
  BackgroundColor #EEF4FB
  BorderColor #526D82
  FontSize 11
}
skinparam package {
  BackgroundColor #FAFCFE
  BorderColor #94A3B8
  FontColor #1E293B
  FontStyle bold
  FontSize 12
}
skinparam database {
  BackgroundColor #E8F3EC
  BorderColor #526D82
}
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #D9B34A
skinparam NoteFontSize 11

title 功能架构子图 2 · 智能问答与校园导航（M3 + M4）

rectangle "数字人交互端\n小程序 / PC 大屏" as ENTRY

package "qa-service : 8101　M3 智能问答（数字人主交互）" {
  package "问答库管理" {
    rectangle "问答条目 CRUD · 分类 · 标签\n启用 / 停用\nF3.1" as F31
  }
  package "问题理解" {
    rectangle "高频问命中的检索\n关键词 + 全文\nF3.2" as F32
    rectangle "意图理解与知识域路由\nF3.3" as F33
    rectangle "口语化提问\nF3.4" as F34
    rectangle "多轮对话 · 追问澄清 · 槽位补全\nF3.5" as F35
  }
  package "应答生成" {
    rectangle "LLM 兜底（问答库知识增强）\nF3.6" as F36
    rectangle "富媒体答案\n图文 / 流程图 / 视频 / 地图点位\nF3.7" as F37
  }
  package "语音与实时通道" {
    rectangle "语音输入 ASR\nF3.8" as F38
    rectangle "语音播报 TTS（驱动口型）\nF3.9" as F39
    rectangle "WebSocket 实时会话\nF3.14" as F314
  }
  package "运营与数据" {
    rectangle "热门问题推荐\nF3.10" as F310
    rectangle "未解答记录与转人工\nF3.11" as F311
    rectangle "热点缓存\nF3.12" as F312
    rectangle "对话记录存储（加密）\nF3.13" as F313
  }
}

package "navigation-service : 8103　M4 校园 AR / 3D 导航" {
  package "地图与检索" {
    rectangle "地图与 POI 数据管理\nF4.1" as F41
    rectangle "POI 检索（名称 / 类别）\nF4.2" as F42
  }
  package "路径规划" {
    rectangle "室外路径规划\nF4.3" as F43
    rectangle "室内导航（楼层 / 房间级）\nF4.4" as F44
    rectangle "步行时间估算\nF4.5" as F45
    rectangle "校内通勤（公交 / 摆渡车）\nF4.6" as F46
  }
  package "交互呈现" {
    rectangle "数字人带路（语音播报）\nF4.7" as F47
    rectangle "地标讲解\nF4.8" as F48
    rectangle "AR 实景导航\nF4.9" as F49
    rectangle "常用地点快捷导航\nF4.10" as F410
  }
}

database "MySQL · yingxin\n问答库 / 会话 / POI 数据" as DB
database "Redis\n热点问答缓存 · 会话上下文" as RD
rectangle "外部依赖\n微信人脸核身 · ASR / TTS 厂商\nLLM 服务 · 腾讯位置服务" as EXT

ENTRY --> F32 : 文字提问
ENTRY --> F38 : 语音提问
ENTRY --> F42 : 搜索地点
ENTRY --> F47 : 请求带路

F32 --> F312 : 先查缓存
F312 --> RD
F32 --> DB : 未命中则检索问答库
F33 --> F36 : 低置信度走 LLM 兜底
F36 --> EXT
F38 --> EXT
F39 --> EXT
F313 --> DB
F37 --> F41 : 答案内嵌地图点位
F43 --> DB : 读取 POI 与路网

note bottom of DB
  **关键约束**
  · 问答库优先命中，LLM 仅兜底（控成本，F3.2 / F3.6）
  · ASR / TTS 供应商待定，先接口抽象 + 本地模拟
  · 地图方案小程序生态优先腾讯位置服务
  · F3.14 WebSocket 依赖尚未引入，实时交互暂以 HTTP 替代
end note

@enduml
