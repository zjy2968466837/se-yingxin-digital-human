@startuml 01-后端技术架构图
!pragma layout smetana
' =====================================================================
' 大学生迎新导引服务数字人系统 —— 后端技术架构图
' 数据来源：backend/pom.xml、各服务 pom.xml、gateway/application.yml、
'          各服务 application.yml、backend/docker-compose*.yml、backend/README.md
' 渲染方式：VS Code「PlantUML」扩展 Alt+D 预览，右键导出 PNG/SVG。
'          已声明 !pragma layout smetana（内置纯 Java 布局引擎），无需安装 Graphviz；
'          若已装 Graphviz(dot) 且想要更规整的布局，删掉这行 pragma 即可切回 dot。
'          命令行：java -jar plantuml.jar -charset UTF-8 -tsvg 01-后端技术架构图.puml
' =====================================================================
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 32
skinparam ArrowColor #526D82
skinparam ArrowFontSize 11
skinparam componentStyle rectangle
skinparam ComponentBorderColor #526D82
skinparam ComponentBackgroundColor #EEF4FB
skinparam ComponentFontSize 12
skinparam DatabaseBorderColor #526D82
skinparam DatabaseBackgroundColor #E8F3EC
skinparam PackageBorderColor #94A3B8
skinparam PackageBackgroundColor #FAFCFE
skinparam PackageFontColor #1E293B
skinparam PackageFontStyle bold
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #D9B34A
skinparam NoteFontSize 11

title 大学生迎新导引服务数字人系统 · 后端技术架构\n<size:12>Java 17 ｜ Spring Boot 3.5.16 ｜ Spring Cloud 2025.0.3 ｜ Maven 多模块（1 网关 + 8 业务服务）</size>

package "1. 接入层 · 客户端（前端项目，非后端）" as L1 {
  component "微信小程序 / H5\nuni-app 3 + Vue 3（Vite 5.2.8）" as C1
  component "管理后台 admin-web\nVue 3 + Vite 8 + Element Plus + Pinia" as C2
  component "PC 现场大屏 / 迎新官网嵌入" as C3
}

package "2. 网关层 · 统一入口（响应式 WebFlux）" as L2 {
  component "gateway : 8080\nSpring Cloud Gateway 4.x（WebFlux）\n· 路径路由 /api/〈服务〉/**（转发不裁剪前缀）\n· 全局 CORS（allowedOriginPatterns=*）\n· Actuator：health / info / gateway\n· 统一鉴权 · 限流防刷（F11.6，规划中）" as GW
}

package "3. 业务服务层 · 核心服务（端口 8100–8107）\nSpring MVC + Validation + MyBatis-Plus + springdoc + Lettuce" as L3 {
  component "auth-service : 8100\n统一身份认证 · 人脸轻核验 · 会话令牌" as S1
  component "qa-service : 8101\n智能问答：问答库 · 意图理解 · 多轮对话" as S2
  component "checkin-service : 8102\n报到流程：步骤引导 · 状态查询 · 待办推送" as S3
  component "navigation-service : 8103\n校园导航：室内外地图 · 路径规划" as S4
  component "aid-service : 8104\n资助与绿色通道" as S5
  component "life-service : 8105\n生活服务：报修 · 缴费 · 食堂 · 快递" as S6
  component "content-service : 8106\n安全教育 · 社团 · 公告 · 话术发布" as S7
  component "admin-service : 8107\n管理后台支撑：统计 · 权限 · 运维" as S8
}

package "4. 数据与缓存层" as L4 {
  database "MySQL 8.0.46\n库 yingxin（按服务分表）\n本地 Docker ／ 云端 Azure MySQL PaaS\n密码与 SSL 走环境变量" as DB
  database "Redis 7.0.15\n热点问答缓存 · JWT 会话\n本地 alpine 镜像 ／ 云端 VM\n本地无密码 ／ 云端 requirepass" as RD
}

C1 --> GW
C2 --> GW
C3 --> GW

GW --> S1 : /api/auth/**
GW --> S2 : /api/qa/**
GW --> S3 : /api/checkin/**
GW --> S4 : /api/navigation/**
GW --> S5 : /api/aid/**
GW --> S6 : /api/life/**
GW --> S7 : /api/content/**
GW --> S8 : /api/admin/**

S1 --> DB
S2 --> DB
S3 --> DB
S4 --> DB
S5 --> DB
S6 --> DB
S7 --> DB
S8 --> DB

S1 --> RD
S2 --> RD
S3 --> RD
S4 --> RD
S5 --> RD
S6 --> RD
S7 --> RD
S8 --> RD

note right of L4
  **技术栈基线（backend/README.md）**
  · JDK 17（Spring Boot 3 要求）
  · Spring Boot 3.5.16
  · Spring Cloud 2025.0.3（须与 Boot 3.5.x 配套）
  · MyBatis-Plus 3.5.17
  · springdoc 2.9.1（2.x 对应 Boot 3）
  · mysql-connector-j 9.7.0
  · Lettuce 6.6.0
  · Maven Wrapper 3.9.12
  · 配置统一 ${环境变量:本地默认值}
end note

note bottom of L2
  **本地与云端差异（代码零改动）**
  本地：9 个服务跑宿主机，MySQL/Redis 在 Docker；
  云端：9 个服务容器化（docker-compose.prod.yml），
  MySQL 用 Azure PaaS，Redis 用云主机 systemd。
end note

note bottom of L3
  **当前实现状态：骨架阶段**
  每个服务仅含 XxxApplication + PingController（/api/<服务>/ping）；
  无统一返回体、无全局异常处理、无 Service/Mapper 分层、无测试类；
  auth-service 尚无 JWT 逻辑，网关无鉴权 Filter；
  服务间无调用、无注册中心（Nacos/Eureka 均未引入）；
  WebSocket 依赖尚未引入（F3.14 规划中）。
end note

@enduml
