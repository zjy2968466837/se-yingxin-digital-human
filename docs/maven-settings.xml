<?xml version="1.0" encoding="UTF-8"?>
<!--
  团队共用的 Maven 配置模板（阿里云镜像，国内下载第三方依赖明显更快）

  用法：复制到你自己的用户目录，只在首次搭环境时做一次
    WSL / Linux / macOS:
        mkdir -p ~/.m2 && cp docs/maven-settings.xml ~/.m2/settings.xml
    Windows (在 WSL 之外用 IDEA/命令行):
        复制到 C:\Users\<你的用户名>\.m2\settings.xml

  说明：
  - 这是"用户级"配置，不会随仓库分发，所以需要手动复制一次。
  - 若你已有 ~/.m2/settings.xml（例如配了公司私服），请手工把 <mirror> 段落合并进去，
    不要直接覆盖。
  - Maven 自身的安装包（由 mvnw 自动下载）走的是 backend/.mvn/wrapper/maven-wrapper.properties，
    与本文件无关。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <!-- 代理中央仓库，加速依赖下载 -->
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Repository</name>
      <mirrorOf>central</mirrorOf>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>

</settings>
