{
  "openapi": "3.1.0",
  "info": {
    "title": "安全教育与入学适应服务接口文档",
    "description": "FR-7 / FR-8 安全教育、入学适应与内容发布",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8106",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "文件存储",
      "description": "小文件批量上传 / 分片上传与后台重组 / 下载 / 删除 / 批量临时地址；后端由 yx.file.provider 选择 local、minio 或 oss"
    },
    {
      "name": "安全教育与入学适应",
      "description": "F11.2 连通性自检：验证服务启动、网关路由与统一响应体"
    }
  ],
  "paths": {
    "/api/content/files/chunks/{uploadId}/{index}": {
      "put": {
        "tags": [
          "文件存储"
        ],
        "summary": "上传单个分片",
        "description": "分片序号从 0 开始；返回已收到的分片数，便于前端显示进度/续传",
        "operationId": "uploadChunk",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "description": "上传会话 id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "分片序号，从 0 开始",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chunk": {
                    "type": "string",
                    "format": "binary",
                    "description": "分片内容（form-data 字段名 chunk）"
                  }
                },
                "required": [
                  "chunk"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMapStringObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files": {
      "post": {
        "tags": [
          "文件存储"
        ],
        "summary": "批量上传小文件",
        "description": "multipart 一次最多 10 个文件；单个 ≤10 MB；按 SHA-256 去重，同内容直接复用已有对象",
        "operationId": "upload",
        "parameters": [
          {
            "name": "files",
            "in": "query",
            "description": "文件列表（form-data 字段名 files）",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultListFileInfoVO"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "文件存储"
        ],
        "summary": "删除文件",
        "description": "按服务端生成的 key 删除对象；不暴露物理路径",
        "operationId": "delete",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "description": "对象 key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files/chunks/{uploadId}/merge": {
      "post": {
        "tags": [
          "文件存储"
        ],
        "summary": "合并分片",
        "description": "校验分片齐全后流式合并、边合并边算 SHA-256，再写入对象存储；可传 fileHash 做二次校验",
        "operationId": "merge",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "description": "上传会话 id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChunkMergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultFileInfoVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files/chunks/init": {
      "post": {
        "tags": [
          "文件存储"
        ],
        "summary": "初始化分片上传",
        "description": "返回 uploadId 与服务端分片大小；若客户端带了整文件 SHA-256 且对象已存在，instant=true 直接秒传",
        "operationId": "initChunk",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChunkInitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultChunkInitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files/batch-urls": {
      "post": {
        "tags": [
          "文件存储"
        ],
        "summary": "批量获取临时地址",
        "description": "一次最多 50 个 key；MinIO/OSS 返回预签名地址，本地实现返回下载接口路径",
        "operationId": "batchUrls",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultListFileUrlVO"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/ping": {
      "get": {
        "tags": [
          "安全教育与入学适应"
        ],
        "summary": "连通性自检",
        "description": "返回服务名、UP 状态与服务器时间",
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultMapStringObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files/{key}": {
      "get": {
        "tags": [
          "文件存储"
        ],
        "summary": "下载文件",
        "description": "返回二进制流（不是统一 Result 包装）；本地实现走本接口，MinIO/OSS 也可直接用预签名地址",
        "operationId": "download",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "对象 key，含斜杠",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "/2026/10/27/3a/3a7b...f1b.pdf"
          },
          {
            "name": "name",
            "in": "query",
            "description": "下载时展示的文件名，可选",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/files/chunks/{uploadId}": {
      "delete": {
        "tags": [
          "文件存储"
        ],
        "summary": "取消分片上传",
        "description": "删除临时分片与 Redis 会话",
        "operationId": "abort",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "description": "上传会话 id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResultMapStringObject": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "FileInfoVO": {
        "type": "object",
        "description": "文件元信息",
        "properties": {
          "key": {
            "type": "string",
            "description": "对象 key（服务端生成，yyyy/MM/dd/<hash前2位>/<sha256>.<ext>）",
            "example": "2026/10/27/3a/3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b.pdf"
          },
          "fileName": {
            "type": "string",
            "description": "原始文件名（仅用于展示，不参与路径拼接）",
            "example": "录取通知书.pdf"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "文件大小（字节）",
            "example": 1048576
          },
          "contentType": {
            "type": "string",
            "description": "MIME 类型",
            "example": "application/pdf"
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 十六进制（去重与完整性校验）",
            "example": "3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b"
          },
          "url": {
            "type": "string",
            "description": "访问地址：MinIO/OSS 为预签名临时地址，本地实现为下载接口路径"
          }
        }
      },
      "ResultListFileInfoVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileInfoVO"
            }
          }
        }
      },
      "ChunkMergeRequest": {
        "type": "object",
        "description": "合并分片请求",
        "properties": {
          "fileHash": {
            "type": "string",
            "description": "整文件 SHA-256（可选；传了就与合并结果比对，不一致返回 2708）",
            "example": "3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      },
      "ResultFileInfoVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/FileInfoVO"
          }
        }
      },
      "ChunkInitRequest": {
        "type": "object",
        "description": "分片上传初始化请求",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "原始文件名（含扩展名，用于类型白名单校验）",
            "example": "报到材料.pdf",
            "minLength": 1
          },
          "fileSize": {
            "type": "integer",
            "format": "int64",
            "description": "文件总大小（字节）",
            "example": 20971520,
            "minimum": 1
          },
          "totalChunks": {
            "type": "integer",
            "format": "int32",
            "description": "分片总数",
            "example": 4,
            "minimum": 1
          },
          "chunkSize": {
            "type": "integer",
            "format": "int64",
            "description": "分片大小（字节），不传则用服务端默认 5 MB",
            "example": 5242880
          },
          "contentType": {
            "type": "string",
            "description": "MIME 类型",
            "example": "application/pdf"
          },
          "fileHash": {
            "type": "string",
            "description": "整文件 SHA-256（可选）：传了可命中秒传，合并后也会校验",
            "example": "3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "fileName",
          "fileSize",
          "totalChunks"
        ]
      },
      "ChunkInitResponse": {
        "type": "object",
        "description": "分片上传初始化结果",
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "上传会话 id；秒传时为空",
            "example": "8f14e45fceea167a5a36dedd4bea2543"
          },
          "chunkSize": {
            "type": "integer",
            "format": "int64",
            "description": "服务端分片大小（字节）",
            "example": 5242880
          },
          "totalChunks": {
            "type": "integer",
            "format": "int32",
            "description": "分片总数",
            "example": 4
          },
          "uploadedChunks": {
            "type": "array",
            "description": "已收到的分片序号（用于断点续传）",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "instant": {
            "type": "boolean",
            "description": "是否命中秒传（服务端已有相同 SHA-256 的对象）"
          },
          "file": {
            "$ref": "#/components/schemas/FileInfoVO",
            "description": "秒传命中的文件信息；非秒传为 null"
          }
        }
      },
      "ResultChunkInitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ChunkInitResponse"
          }
        }
      },
      "BatchUrlRequest": {
        "type": "object",
        "description": "批量获取临时下载地址请求",
        "properties": {
          "keys": {
            "type": "array",
            "description": "对象 key 列表（一次最多 50 个）",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "keys"
        ]
      },
      "FileUrlVO": {
        "type": "object",
        "description": "临时下载地址",
        "properties": {
          "key": {
            "type": "string",
            "description": "对象 key"
          },
          "url": {
            "type": "string",
            "description": "临时访问地址"
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64",
            "description": "有效期（秒）"
          }
        }
      },
      "ResultListFileUrlVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileUrlVO"
            }
          }
        }
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      }
    }
  }
}
