# 通用
SPRING_PROFILES_ACTIVE=dev

# MySQL（开发环境：Azure 开发库；生产环境：Azure 生产库）
MYSQL_HOST=your-mysql-host.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DB=se_yingxin
MYSQL_USER=your_db_user
MYSQL_PASSWORD=change_me

# Redis（开发环境：本机 Docker；生产环境：VM 本机 Redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 可选：JDBC 安全参数（MySQL PaaS 建议强制 SSL）
MYSQL_SSL_PARAMS=useSSL=true&requireSSL=true&useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai
