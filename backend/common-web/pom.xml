<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sicnu.yingxin</groupId>
    <artifactId>yingxin-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>common-web</artifactId>
  <name>common-web</name>
  <description>公共 Web 模块：全局异常处理、参数校验适配</description>

  <!--
    仅 8 个业务服务可用，网关不可依赖本模块（见 docs/开发规范.md §1.3）。
    网关基于 WebFlux，本模块的 @RestControllerAdvice / HttpServletRequest 属 Servlet 栈，
    被网关引用会导致其启动失败。
  -->
  <dependencies>
    <dependency>
      <groupId>com.sicnu.yingxin</groupId>
      <artifactId>common-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 参数校验：Controller 上的 @Validated 与 ConstraintViolationException 处理需要 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 同 common-core：本模块是被依赖的库，跳过可执行 jar 打包 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
