{
  "//": "与 .gitattributes / .editorconfig 保持同一套约定，减少跨平台差异",
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "editor.detectIndentation": false,
  "[java]": {
    "editor.tabSize": 4
  },
  "[xml]": {
    "editor.tabSize": 4
  },
  "[sql]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "ReneSaarsoo.sql-formatter-vsc",
    "editor.formatOnSave": false
  },
  "SQL-Formatter-VSCode.dialect": "mysql",
  "SQL-Formatter-VSCode.keywordCase": "upper",
  "SQL-Formatter-VSCode.dataTypeCase": "upper",
  "SQL-Formatter-VSCode.expressionWidth": 100,
  "database-client.defaultSelectLimit": 200,
  "database-client.highlightSQLBlock": true,
  "database-client.confirmWhenUpdateWithoutWhere": true,
  "database-client.telemetry.usesOnlineServices": false
}
