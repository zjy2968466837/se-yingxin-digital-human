# 引擎/构建产物
[Bb]uild/
[Dd]ist/
[Ll]ibrary/
[Oo]bj/
[Tt]emp/
# PlantUML 扩展的导出目录（构建产物，不入库；成品图统一放 docs/架构图/，只提交 svg）
/out/
*.apk
*.aab
*.exe
*.dll
*.so
*.dylib

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Unity
*.csproj
*.sln
*.user
*.pidb
*.booproj
.vs/
.idea/
ExportedObj/

# Godot
.godot/
*.translation

# 语言/工具
__pycache__/
node_modules/
.venv/
coverage/
*.log
.DS_Store
Thumbs.db

# AI 编码工具的工作目录（导出中间产物，不入库）
.codebuddy/

# 敏感配置（API Key、数据库密码等）
application-local.yml
application-prod.yml
.env
.env.*
*.local
.env.prod

# 前端默认配置不含密码，需要入库（上面的 .env.* 会误伤）
!frontend/*/.env.development

# 本地数据库凭据，只在本机用，禁止入库
docs/本地数据库-勿上传.md

# 代理/编辑器工具状态，不入库
.zcode/
.vscode/*.code-profile
skills-lock.json
